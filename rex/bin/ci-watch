#!/usr/bin/env zsh
# ci-watch [BRANCH]
# Watches the latest pipeline of your open GitLab MRs for BRANCH (the current
# branch by default) and its stack parts (BRANCH/...). Shows them as a table,
# reports the overall state to Rex with OSC 7501, and sends a macOS
# notification when a pipeline fails. CI_WATCH_INTERVAL sets the poll seconds.

interval=${CI_WATCH_INTERVAL:-60}
branch=${1:-$(git branch --show-current)}
[[ -n $branch ]] || { print -u2 "ci-watch: not on a branch"; exit 1 }
user=$(glab api user | jq -r .username) || exit 1

typeset -A notified

b64() { print -rn -- $1 | base64 }

report() {
  printf '\e]7501;state=%s:app=ci-watch:title=%s:msg=%s\a' $1 $(b64 "CI $branch") $(b64 $2)
}

notify() {
  osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null
}

failed_jobs() {
  glab api "projects/:id/pipelines/$1/jobs?scope[]=failed&per_page=100" |
    jq -r '[.[].name] | unique | join(", ")'
}

while true; do
  mrs=$(glab mr list --author=$user --per-page 100 -F json 2>/dev/null |
    jq -r --arg b $branch '.[]
      | select(.source_branch == $b or (.source_branch | startswith($b + "/")))
      | [.iid, .title] | @tsv' | sort -n)

  rows=() failed=0 running=0 passed=0
  while IFS=$'\t' read -r iid title; do
    [[ -n $iid ]] || continue
    pipeline=$(glab api "projects/:id/merge_requests/$iid/pipelines?per_page=1" |
      jq -r '.[0] // empty | [.id, .status] | @tsv')
    id=${pipeline%%$'\t'*} pstatus=${pipeline##*$'\t'}
    [[ -n $pipeline ]] || pstatus=none

    case $pstatus in
      failed)
        (( failed++ ))
        if [[ -z ${notified[$id]} ]]; then
          notified[$id]=1
          notify "CI failed on !$iid" "$(failed_jobs $id)"
        fi ;;
      created|waiting_for_resource|preparing|pending|running) (( running++ )) ;;
      success) (( passed++ )) ;;
    esac
    rows+=("$(printf '!%-6s %-9s %s' $iid $pstatus $title)")
  done <<< $mrs

  if (( ${#rows} == 0 )); then
    report idle "no open MRs for $branch"
  elif (( failed )); then
    report error "$failed of ${#rows} pipelines failed"
  elif (( running )); then
    report working "$running of ${#rows} pipelines running"
  else
    report done "$passed of ${#rows} pipelines passed"
  fi

  print -n '\e[H\e[2J'
  print -P "%BCI for $branch%b  (every ${interval}s, last $(date +%H:%M))"
  print -l -- ${rows:-"no open MRs by $user for $branch"}
  sleep $interval
done
