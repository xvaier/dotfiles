[core]
  excludesfile = ~/.global.gitignore
[user]
	email = xavier.lavallee@gmail.com
	name = Xavier Lavallee
[commit]
	gpgsign = true
[alias]
  s = status -b -s
  gg = grep -n --color
  heat = blame -M -C -C -C
  lol = log --oneline --decorate
  graph = log --oneline --graph --decorate
  root = rev-parse --show-toplevel
  # https://andrewlock.net/pushing-a-whole-stack-of-branches-with-a-single-git-command/
	default-branch = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"
	merge-base-origin ="!f() { git merge-base ${1-HEAD} origin/$(git default-branch); };f "
	stack = "!f() { \
		BRANCH=${1-HEAD}; \
		MERGE_BASE=$(git merge-base-origin $BRANCH); \
		git log --decorate-refs=refs/heads --simplify-by-decoration --pretty=format:\"%(decorate:prefix=,suffix=,tag=,separator=%n)\" $MERGE_BASE..$BRANCH; \
	};f "
	push-stack = "!f() { \
		BRANCH=${1-HEAD}; \
		git stack $BRANCH | xargs -I {} git push --force-with-lease origin {}; \
	};f "
	# Absolute path of the primary worktree, even when run from a linked one.
	main-worktree = "!git worktree list --porcelain | sed -n '1s/^worktree //p'"
	# Linked worktrees under .worktrees/, named by their path relative to it.
	worktree-names = "!f() { \
		ROOT=$(git main-worktree); \
		git worktree list --porcelain \
			| sed -n 's|^worktree '\"$ROOT\"'/.worktrees/||p'; \
	};f "
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	defaultKeyCommand = ssh-add -L
[grep]
  lineNumber = true
  patternType = perl
[interactive]
    diffFilter = delta --color-only
[merge]
    conflictstyle = zdiff3
[blame]
	coloring = highlightRecent
  date = human
[rerere]
  enabled = true

[color]
  ui = auto
[color "blame"]
	highlightRecent = White,24 month ago,Magenta,12 month ago,Blue,6 month ago,Yellow,8 week ago,Red,2 week ago,bold Red
[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green
[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
[color "status"]
  added = yellow
  changed = green
  untracked = cyan
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# gitconfig-flare is gitignored; the include is a no-op without it.
[includeIf "gitdir:~/Developer/flare/"]
	path = ~/.gitconfig-flare
