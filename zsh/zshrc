# Nested interactive shells re-run the prepends below, so dedupe.
typeset -U path PATH

setopt HIST_IGNORE_ALL_DUPS
bindkey -v
setopt CORRECT
SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '

# Drop / from WORDCHARS so word-wise motions stop at path segments.
WORDCHARS=${WORDCHARS//[\/]}

# Safe only while zsh-autosuggestions is the last module in .zimrc.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Lazy-load: `nvm use default` at startup is slow. Homebrew's node stays available.
export NVM_DIR="$HOME/.nvm"
nvm() { unset -f nvm; [[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"; nvm "$@"; }

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  if (( ${+commands[curl]} )); then
    curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    mkdir -p ${ZIM_HOME} && wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi
# Rebuild init.zsh when .zimrc is newer.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZDOTDIR:-${HOME}}/.zimrc ]]; then
  source ${ZIM_HOME}/zimfw.zsh init -q
fi
source ${ZIM_HOME}/init.zsh

cd_to_git_root() {
    cd "$(git rev-parse --show-toplevel)"
}
alias cdg="cd_to_git_root"

zmodload -F zsh/terminfo +p:terminfo
# Bound manually so up/down work both before and after zle-line-init.
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
for key ('k') bindkey -M vicmd ${key} history-substring-search-up
for key ('j') bindkey -M vicmd ${key} history-substring-search-down
unset key

# Lazy-load: shims go on PATH cheaply so `.python-version` still switches;
# full init defers to the first `pyenv` call.
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="$PYENV_ROOT/shims:$PATH"
pyenv() { unset -f pyenv; eval "$(command pyenv init - zsh)"; pyenv "$@"; }

eval "$(direnv hook zsh)"

export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
[ -f ~/.flare.zsh ] && source ~/.flare.zsh
[ -f ~/.git-worktree.zsh ] && source ~/.git-worktree.zsh
export PATH="$HOME/.local/bin:$PATH"
