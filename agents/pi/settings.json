{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "catppuccin-mocha",
  "quietStartup": true,
  "tuiMode": "fullscreen",
  "fullscreenCopyOnSelect": true,
  "showHardwareCursor": true,
  "terminal": {
    "trueColor": "auto",
    "hyperlinks": "auto",
    "images": "auto",
    "showTerminalProgress": false
  },
  "defaultTools": [
    "+grep",
    "+find"
  ],
  "extensions": [
    "extensions/cli-fit.ts",
    "extensions/statusline.ts",
    "extensions/git-context.ts",
    "extensions/worktree-shortcuts.ts",
    "extensions/session-title.ts",
    "+extensions/prompt-editor.ts",
    "+extensions/minimal-transcript.ts",
    "+extensions/quit.ts",
    "+extensions/slash-command-guard.ts",
    "+extensions/quote-final-response.ts"
  ],
  "themes": [
    "themes/catppuccin-mocha.json"
  ],
  "lastChangelogVersion": "1.5.0"
}