#!/usr/bin/env bash
# Publication checks fail closed; optional private-file backup only warns.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
python3 "$root/scripts/check-publication.py" --require-local
if ! command -v gitleaks >/dev/null; then
  echo "Publication guard: install gitleaks (brew install gitleaks) before committing." >&2
  exit 1
fi
# Scan added staged lines. Full-history scanning also runs in CI.
git diff --cached --no-ext-diff --no-textconv --unified=0 --diff-filter=ACMR |
  gitleaks stdin --redact --no-banner

cache="$(git rev-parse --git-dir)/1password-sync"
mkdir -p "$cache"

command -v op >/dev/null || exit 0

while IFS='|' read -r path title; do
  [[ -z "$path" || "$path" == \#* ]] && continue
  file="$root/$path"
  [ -f "$file" ] || continue

  stamp="$cache/${path//\//_}.sha"
  sum=$(shasum -a 256 "$file" | cut -d' ' -f1)
  [ "$sum" = "$(cat "$stamp" 2>/dev/null)" ] && continue

  if op document edit "$title" "$file" --vault Private >/dev/null 2>&1; then
    echo "$sum" >| "$stamp"
    echo "1password: synced $path"
  else
    echo "1password: couldn't sync $path to '$title' (create the Document first if missing)" >&2
  fi
done < "$root/1password-files"

exit 0
